{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "DBmarlin",
  "id": "dbmarlin-dbmarlin-datasource",
  "metrics": true,
  "backend": true,
  "executable": "gpx_dbmarlin",
  "info": {
    "description": "Query DBmarlin database performance data: activity (DB time / AAS), top SQL and waits, host and database statistics, and alerts and changes as annotations.",
    "author": {
      "name": "DBmarlin",
      "url": "https://www.dbmarlin.com"
    },
    "keywords": ["dbmarlin", "database", "performance", "monitoring", "datasource"],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Website",
        "url": "https://www.dbmarlin.com"
      },
      {
        "name": "documentation",
        "url": "https://docs.dbmarlin.com/docs/integrations/grafana/"
      },
      {
        "name": "repository",
        "url": "https://github.com/DBmarlin/dbmarlin-grafana-datasource"
      },
      {
        "name": "license",
        "url": "https://github.com/DBmarlin/dbmarlin-grafana-datasource/blob/main/LICENSE"
      },
      {
        "name": "raise issue",
        "url": "https://github.com/DBmarlin/dbmarlin-grafana-datasource/issues"
      }
    ],
    "screenshots": [
      {
        "name": "Instance overview dashboard",
        "path": "img/instance-overview.png"
      },
      {
        "name": "Fleet overview dashboard",
        "path": "img/fleet-overview.png"
      },
      {
        "name": "Query editor with alert annotations",
        "path": "img/query-editor.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=11.0.0",
    "plugins": []
  },
  "alerting": true,
  "annotations": true,
  "includes": [
    {
      "type": "dashboard",
      "name": "DBmarlin - Instance overview",
      "path": "dashboards/instance-overview.json"
    },
    {
      "type": "dashboard",
      "name": "DBmarlin - Fleet overview",
      "path": "dashboards/fleet-overview.json"
    }
  ]
}
